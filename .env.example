# Боевой URL без завершающего слэша. Пока домена нет — оставляем пустым.
NEXT_PUBLIC_SITE_URL=

# Коды верификации Вебмастера и Search Console — подставить, когда заказчик даст.
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Те же коды можно задать без NEXT_PUBLIC_ — они всё равно попадут в HTML.
# YANDEX_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=

# Номер счётчика Яндекс.Метрики. По умолчанию в коде: 111903056.
# NEXT_PUBLIC_YANDEX_METRIKA_ID=111903056

# Опционально, если ссылки отличаются от значений в lib/site.ts
# NEXT_PUBLIC_TELEGRAM_URL=

# SMTP Timeweb для заявок с формы. Не коммитить пароль — только .env.local
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@martensit-group.ru
SMTP_PASS=
SMTP_TO=info@martensit-group.ru
SMTP_FROM="Мартенсит <info@martensit-group.ru>"

